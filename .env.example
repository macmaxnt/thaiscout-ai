# ============================================================
#  ThaiScout AI — Environment Variables Template
#  Copy this file to .env.local and fill in the values
#  cp .env.example .env.local
# ============================================================

# ----------------------------------------------------------
# 🤖 Google Gemini API (AI Engine)
# Get your key: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------------------------------
# 🗺️ Google Places API (Place Photos & Location Data)
# Get your key: https://console.cloud.google.com/apis/credentials
# Enable: "Places API" in your GCP project
# ----------------------------------------------------------
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ----------------------------------------------------------
# 🗄️ Supabase (Database — 8,628 Tourist Locations)
# Project: thaiscout-ai on app.supabase.com
# Get your keys: https://supabase.com/dashboard/project/_/settings/api
# ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side only (same values as above, for API routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
